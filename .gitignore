# ==========================================
# Unity Git Configuration - Track Assets, Packages & ProjectSettings
# ==========================================

# 1. Ignore everything in the project root by default
/*

# 2. Allow Git configuration and documentation
!/.gitignore
!/README.md
!/DATAFLOW.md

# 3. Whitelist the Assets directory and all its contents
!/Assets/
!/Assets/**

# 4. Whitelist Packages and ProjectSettings configurations
!/Packages/
!/Packages/**
!/ProjectSettings/
!/ProjectSettings/**

# 5. Explicitly ignore generated datasets, cache, and editor temp folders
/Library/
/Temp/
/Logs/
/UserSettings/
/obj/
/Dataset/
*.csproj
*.sln
.DS_Store
